# GECRAI 1.2 Frontend - Development Dockerfile
FROM node:18-alpine

WORKDIR /app

# Install dependencies first (for better caching)
COPY package*.json ./
RUN npm install

# Copy source code
COPY . .

# Expose Vite development port
EXPOSE 3000

# Run in development mode with host access for Docker
CMD ["npm", "run", "dev", "--", "--host"]
